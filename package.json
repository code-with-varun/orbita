{
  "name": "orbita-work-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "development",
    "testing"
  ],
  "scripts": {
    "dev": "npm --prefix development run dev",
    "build": "npm --prefix development run build && node -e \"import('fs').then(fs => { if(!fs.existsSync('dist')) fs.mkdirSync('dist'); fs.cpSync('development/dist', 'dist', {recursive:true}); })\"",
    "preview": "npm --prefix development run preview",
    "server": "node development/server/server.js",
    "start": "node development/server/server.js",
    "test": "npm --prefix testing run test",
    "cypress:run": "npm --prefix testing run cypress:run",
    "cypress:open": "npm --prefix testing run cypress:open"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "mongoose": "^9.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.21.1",
    "vite": "^6.1.0"
  }
}
